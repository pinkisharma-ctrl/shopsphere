{
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/**/*.ts", // This includes all TypeScript files in the src folder
    "src/app/remote-entry/**/*.ts"  // Explicitly include all TypeScript files in remote-entry folder
  ],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
